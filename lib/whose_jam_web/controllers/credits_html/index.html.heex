<main
  data-theme="jam"
  class="jam-stage min-h-screen px-6 pt-10 pb-16 sm:px-12 lg:px-20 lg:pt-14"
>
  <div class="mx-auto w-full max-w-2xl space-y-10">
    <header class="flex items-center justify-between gap-4">
      <.wordmark class="text-2xl sm:text-3xl" />
      <a
        id="back-home"
        href={~p"/"}
        class="jam-btn-ghost text-sm font-bold px-4 py-2 rounded-lg"
      >
        Back to the start
      </a>
    </header>

    <div class="space-y-3">
      <h1 class="font-display text-5xl sm:text-6xl leading-none">Credits</h1>
      <p class="text-lg font-medium text-jam-cream/70 text-balance">
        The people and the tools behind Whose Jam.
      </p>
    </div>

    <section id="credits-people" class="jam-paper rounded-lg p-6 sm:p-8 text-jam-ink space-y-7">
      <div class="space-y-1">
        <h2 class="text-sm font-semibold text-jam-ink/65">Originator</h2>
        <p id="credit-originator" class="font-display text-3xl leading-tight">Sierra Cordell</p>
      </div>

      <div class="space-y-1">
        <h2 class="text-sm font-semibold text-jam-ink/65">Tech lead</h2>
        <p id="credit-tech-lead" class="font-display text-3xl leading-tight">Jared Dean</p>
      </div>

      <div class="space-y-2">
        <h2 class="text-sm font-semibold text-jam-ink/65">Quality assurance</h2>
        <ul id="credits-qa" class="space-y-1 text-xl font-semibold">
          <li :for={name <- ["Zack Kreider", "Kyle Barker", "Aaron Stirewalt", "Sam Worley"]}>
            {name}
          </li>
        </ul>
      </div>
    </section>

    <section id="credits-ai" class="space-y-4">
      <h2 class="font-display text-3xl">AI disclosure</h2>
      <ul class="space-y-3 text-lg font-medium text-jam-cream/80 text-pretty">
        <li>
          Code generated using Anthropic’s Opus and Claude models, and audited and secured by OpenAI’s Sol model.
        </li>
        <li>
          Original logo generated by an OpenAI image generation model, rebuilt by Opus as an SVG.
        </li>
      </ul>
    </section>
  </div>
</main>
