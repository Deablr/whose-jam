[
  verbose: false,
  private: true,
  skip: true,
  router: "lib/whose_jam_web/router.ex",
  exit: "low",
  format: "txt",
  out: "",
  threshold: "low",
  # Dependency advisories come from `mix hex.audit`; Sobelow's Vuln checks use a
  # stale built-in list and emit parser warnings on mix.lock.
  ignore: ["Vuln"],
  ignore_files: [""],
  version: false
]
