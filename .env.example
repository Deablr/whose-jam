# Copy to .env and fill in. Only SECRET_KEY_BASE is required to boot.

# REQUIRED — cookie/session signing secret. Generate with:
#   openssl rand -base64 48
SECRET_KEY_BASE=

# Hostname phones use to reach this machine (QR join links). For a party, use
# your machine's LAN IP, e.g. 192.168.1.23. (The Spotify OAuth redirect does
# NOT use this — it always defaults to 127.0.0.1, see SPOTIFY_REDIRECT_URI.)
PHX_HOST=localhost

# LOCAL ONLY: host port to publish the app on (via docker-compose.override.yml;
# also used in generated URLs). Ignored by Dokploy/Traefik deployments, which
# publish no ports — set PHX_SCHEME=https and URL_PORT=443 there instead.
APP_PORT=4000

# Postgres password for the bundled db container (change for real deployments).
POSTGRES_PASSWORD=postgres

# Spotify app credentials — required for song search and TV playback.
# Create an app at https://developer.spotify.com/dashboard and add
#   http://127.0.0.1:4000/auth/spotify/callback
# as a redirect URI (match your APP_PORT; Spotify rejects `localhost` and any
# non-HTTPS host that isn't a loopback IP — 127.0.0.1 works because the host
# connects Spotify from the machine running the server).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Only needed for an https deployment (e.g. behind a TLS proxy):
#   SPOTIFY_REDIRECT_URI=https://your.domain/auth/spotify/callback
# When unset, defaults to http://127.0.0.1:<APP_PORT>/auth/spotify/callback.
#SPOTIFY_REDIRECT_URI=

# YouTube (optional second music service) — from one Google Cloud project:
#   1. Enable "YouTube Data API v3" and create an API key (song search). Give
#      it no application restriction (or an IP restriction) — not "Websites":
#      the server calls Google with it and sends no referrer.
#   2. Configure the OAuth consent screen and create an OAuth client of type
#      "Web application" (the host's Google sign-in), with
#        http://localhost:4000/auth/youtube/callback
#      as an authorized redirect URI (match your APP_PORT). It is `localhost`
#      on purpose: YouTube won't play on a page opened by IP address.
# All three must be set for YouTube to be offered. Google allows a project
# about 100 song searches a day unless you request more quota.
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Only needed for an https deployment:
#   YOUTUBE_REDIRECT_URI=https://your.domain/auth/youtube/callback
